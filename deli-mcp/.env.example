# Copy to .env and `export $(grep -v '^#' .env | xargs)` if you want a password.
# The MCP server / seeder read these straight from the environment.
DELI_DB_HOST=127.0.0.1
DELI_DB_PORT=3306
DELI_DB_USER=root
DELI_DB_PASSWORD=
DELI_DB_NAME=deli

# seeder volume overrides (optional)
DELI_USERS=10000
DELI_RESTAURANTS=2000
DELI_ORDERS=50000
DELI_SEED=20260527
