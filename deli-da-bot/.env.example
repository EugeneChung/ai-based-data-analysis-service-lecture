# Slack Bot Token (xoxb-...)  — OAuth & Permissions 페이지에서 발급
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token (xapp-...) — Socket Mode 용. Basic Information → App-Level Tokens 에서 생성
# scope: connections:write
SLACK_APP_TOKEN=xapp-...

# reply-all 화이트리스트 (comma separated). 이 채널의 모든 메시지에 봇이 응답.
# 빈 값이면 reply-all 모드 비활성, @멘션 / DM 만 동작.
# 예) C0B7A7WA360 (테스트 채널)
REPLY_ALL_CHANNEL_IDS=

# 로그 레벨 (DEBUG / INFO / WARNING)
LOG_LEVEL=INFO
